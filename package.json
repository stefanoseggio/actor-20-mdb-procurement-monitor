{
    "name": "actor-20-mdb-procurement-monitor",
    "version": "2.1.0",
    "type": "module",
    "description": "Multilateral Development Bank Procurement Monitor: extracts the World Bank's public Procurement Notices API and the World Bank's static 'Other Sanctions' debarment sub-table, normalized to the fleet's 18-field Unified Master Schema. ADB and IDB procurement feeds were live-researched and are deliberately deferred - see README.md for the compliance findings.",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "1.0.0-rc.12",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.0",
        "zod-to-json-schema": "^3.23.5"
    },
    "scripts": {
        "start": "node dist/main.js",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "Stefano",
    "license": "Apache-2.0"
}
